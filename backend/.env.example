# --- Agora (see ../SETUP.md) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# --- Gemini (scam classifier) — free tier at aistudio.google.com/apikey ---
# The deterministic rule layer in app/rules.py works without this key; the model
# adds the judgement calls keywords cannot make.
GEMINI_API_KEY=
CLASSIFIER_MODEL=gemini-3.5-flash-lite

# --- Public URL of THIS backend, reachable by Agora's servers ---
# Agora calls PUBLIC_BASE_URL/v1/chat/completions as the custom LLM.
# Localhost will NOT work. During development use a tunnel:
#   ngrok http 8000     ->  https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=

# --- Guard tuning ---
# Risk score (0-100) at or above which the agent barges in with a warning.
WARN_THRESHOLD=70
# Below this, stay completely silent and don't even log an advisory.
NOTICE_THRESHOLD=40

# --- Demo defaults ---
DEFAULT_LANGUAGE=ta-IN
